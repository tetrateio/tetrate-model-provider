{
    "name": "tetrate-model-provider",
    "publisher": "tetrate",
    "displayName": "Tetrate Agent Router Model Provider",
    "description": "Provides language models from Tetrate Agent Router Service to VS Code chat and to other extensions",
    "version": "0.5.0",
    "license": "Apache-2.0",
    "icon": "images/icon.png",
    "galleryBanner": {
        "color": "#1B1B1F",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tetrateio/tetrate-model-provider.git"
    },
    "homepage": "https://github.com/tetrateio/tetrate-model-provider#readme",
    "bugs": {
        "url": "https://github.com/tetrateio/tetrate-model-provider/issues"
    },
    "qna": "https://github.com/tetrateio/tetrate-model-provider/issues",
    "pricing": "Free",
    "engines": {
        "vscode": "^1.106.0"
    },
    "extensionKind": [
        "ui",
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": true,
            "description": "The extension reads no workspace content. The settings that carry the API key to an endpoint are machine-scoped, so a workspace cannot redirect it."
        },
        "virtualWorkspaces": true
    },
    "categories": [
        "AI",
        "Chat",
        "Machine Learning"
    ],
    "keywords": [
        "ai",
        "chat",
        "language model",
        "tetrate",
        "agent router",
        "byok",
        "openai-compatible"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "languageModelChatProviders": [
            {
                "vendor": "tetrate-agent-router",
                "displayName": "Tetrate Agent Router",
                "managementCommand": "tetrate-model-provider.setApiKey"
            }
        ],
        "commands": [
            {
                "command": "tetrate-model-provider.setApiKey",
                "title": "Tetrate Agent Router: Set Agent Router API Key"
            },
            {
                "command": "tetrate-model-provider.clearApiKey",
                "title": "Tetrate Agent Router: Clear Agent Router API Key"
            },
            {
                "command": "tetrate-model-provider.setBaseUrl",
                "title": "Tetrate Agent Router: Set Base URL"
            },
            {
                "command": "tetrate-model-provider.refreshModels",
                "title": "Tetrate Agent Router: Refresh Model List"
            },
            {
                "command": "tetrate-model-provider.showUsage",
                "title": "Tetrate Agent Router: Show Session Usage"
            },
            {
                "command": "tetrate-model-provider.showStatus",
                "title": "Tetrate Agent Router: Show Connection Status"
            },
            {
                "command": "tetrate-model-provider.switchEndpoint",
                "title": "Tetrate Agent Router: Switch Endpoint"
            },
            {
                "command": "tetrate-model-provider.chooseModels",
                "title": "Tetrate Agent Router: Choose Models"
            },
            {
                "command": "tetrate-model-provider.menu",
                "title": "Tetrate Agent Router: Command Menu"
            },
            {
                "command": "tetrate-model-provider.testConnection",
                "title": "Tetrate Agent Router: Test Connection"
            },
            {
                "command": "tetrate-model-provider.addProfile",
                "title": "Tetrate Agent Router: Add Endpoint Profile",
                "icon": "$(add)"
            },
            {
                "command": "tetrate-model-provider.removeProfile",
                "title": "Tetrate Agent Router: Remove Endpoint Profile",
                "icon": "$(trash)"
            },
            {
                "command": "tetrate-model-provider.useInChat",
                "title": "Tetrate Agent Router: Use Model in Chat",
                "icon": "$(comment-discussion)"
            },
            {
                "command": "tetrate-model-provider.refreshModelsView",
                "title": "Refresh",
                "icon": "$(refresh)"
            },
            {
                "command": "tetrate-model-provider.openDashboard",
                "title": "Open Usage Dashboard",
                "icon": "$(graph)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "tetrate-model-provider.refreshModelsView",
                    "when": "view == tetrate-model-provider.overview",
                    "group": "navigation@1"
                },
                {
                    "command": "tetrate-model-provider.openDashboard",
                    "when": "view == tetrate-model-provider.overview",
                    "group": "navigation@2"
                }
            ],
            "view/item/context": [
                {
                    "command": "tetrate-model-provider.useInChat",
                    "when": "view == tetrate-model-provider.overview && viewItem == model",
                    "group": "inline"
                },
                {
                    "command": "tetrate-model-provider.removeProfile",
                    "when": "view == tetrate-model-provider.overview && viewItem == profile",
                    "group": "inline"
                },
                {
                    "command": "tetrate-model-provider.addProfile",
                    "when": "view == tetrate-model-provider.overview && viewItem == profiles",
                    "group": "inline"
                }
            ]
        },
        "chatParticipants": [
            {
                "id": "tetrate-model-provider.tetrate",
                "fullName": "Tetrate Agent Router",
                "name": "tetrate",
                "description": "Usage, models, and endpoints of the Agent Router",
                "commands": [
                    {
                        "name": "usage",
                        "description": "Today's and this session's usage and cost"
                    },
                    {
                        "name": "models",
                        "description": "Find offered models by capability, price, or name"
                    },
                    {
                        "name": "switch",
                        "description": "Switch to a named endpoint profile"
                    }
                ]
            }
        ],
        "configuration": {
            "title": "Tetrate Agent Router Model Provider",
            "properties": {
                "tetrate-model-provider.baseUrl": {
                    "type": "string",
                    "default": "https://api.router.tetrate.ai/v1",
                    "scope": "machine",
                    "markdownDescription": "Base URL of the OpenAI-compatible Agent Router endpoint. Change this to target a self-hosted or Enterprise deployment; the URL must end in `/v1`.\n\nMachine-scoped: settable in User settings only. The API key is sent to this host, so a workspace is not allowed to redirect it.",
                    "pattern": "^\\s*(https?://\\S+)?\\s*$",
                    "patternErrorMessage": "Must be an http(s) URL."
                },
                "tetrate-model-provider.modelFilter": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "markdownDescription": "Only offer models whose id matches one of these glob patterns, for example `claude-*` or `gpt-5.6-terra`. Leave empty to offer every chat model the API key can reach."
                },
                "tetrate-model-provider.modelOverrides": {
                    "type": "object",
                    "default": {},
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "contextWindow": {
                                "type": "number",
                                "minimum": 1,
                                "description": "Context window in tokens, replacing the catalog value. Intended for models the public catalog does not describe."
                            },
                            "maxOutputTokens": {
                                "type": "number",
                                "minimum": 1,
                                "description": "Output limit in tokens, replacing the catalog value."
                            },
                            "maxTokens": {
                                "type": "number",
                                "minimum": 1,
                                "description": "Hard output cap sent as max_tokens with every request to matching models, unlike maxOutputTokens, which only adjusts the advertised budget. Some OpenAI reasoning models reject max_tokens in favour of max_completion_tokens."
                            },
                            "temperature": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 2,
                                "description": "Sampling temperature sent with every request to matching models."
                            },
                            "reasoningEffort": {
                                "type": "string",
                                "enum": [
                                    "minimal",
                                    "low",
                                    "medium",
                                    "high"
                                ],
                                "description": "Reasoning effort sent with every request to matching models. Only meaningful for reasoning models."
                            }
                        },
                        "additionalProperties": false
                    },
                    "markdownDescription": "Per-model settings, keyed by the same `*` glob patterns as `#tetrate-model-provider.modelFilter#`. When several patterns match one model, later entries win field by field. Example: `{ \"claude-*\": { \"reasoningEffort\": \"high\" } }`."
                },
                "tetrate-model-provider.requestHeaders": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "default": {},
                    "scope": "machine",
                    "markdownDescription": "Extra HTTP headers to send with every request, for example a routing hint or a tenant identifier. Do not put the API key here — it is kept in secret storage.\n\nMachine-scoped: settable in User settings only. `Authorization` cannot be set here; it is always derived from the stored key."
                },
                "tetrate-model-provider.profiles": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "default": {},
                    "scope": "machine",
                    "markdownDescription": "Named endpoints for the **Switch Endpoint** command, for example `{ \"Production\": \"https://api.router.tetrate.ai/v1\", \"Staging\": \"https://router.tare-staging.tetrate.ai/v1\" }`. Each endpoint keeps its own API key.\n\nMachine-scoped: settable in User settings only, since the API key is sent to the selected URL."
                },
                "tetrate-model-provider.spendWarning": {
                    "type": "number",
                    "minimum": 0,
                    "default": 0,
                    "markdownDescription": "Raise a warning once the day's estimated Agent Router cost reaches this many dollars. `0` disables the warning. Costs are estimated from the public catalog's prices, so the warning is advisory; the dashboard is the billing authority."
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "tetrate-agent-router",
                    "title": "Tetrate Agent Router",
                    "icon": "images/logo.svg"
                }
            ]
        },
        "views": {
            "tetrate-agent-router": [
                {
                    "id": "tetrate-model-provider.overview",
                    "name": "Overview",
                    "icon": "images/logo.svg",
                    "contextualTitle": "Tetrate Agent Router"
                },
                {
                    "id": "tetrate-model-provider.requests",
                    "name": "Recent Requests",
                    "icon": "images/logo.svg",
                    "contextualTitle": "Agent Router Requests"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "tetrate-model-provider.overview",
                "contents": "No Agent Router API key is stored for the configured endpoint. Keys are created in the [dashboard](https://router.tetrate.ai/).\n[Set API Key](command:tetrate-model-provider.setApiKey)\n[Switch Endpoint](command:tetrate-model-provider.switchEndpoint)"
            }
        ],
        "walkthroughs": [
            {
                "id": "gettingStarted",
                "title": "Get started with Tetrate Agent Router",
                "description": "Chat with Anthropic, OpenAI, Google, and more behind one endpoint and one bill.",
                "steps": [
                    {
                        "id": "createKey",
                        "title": "Create an API key",
                        "description": "An API key is created in the Agent Router dashboard and grants access to every routed model.\n[Open the Dashboard](https://router.tetrate.ai/)",
                        "media": {
                            "markdown": "media/walkthrough/create-key.md"
                        }
                    },
                    {
                        "id": "storeKey",
                        "title": "Store the API key",
                        "description": "The key is held in VS Code secret storage, scoped to the endpoint host. It is never written to a settings file.\n[Set API Key](command:tetrate-model-provider.setApiKey)",
                        "media": {
                            "markdown": "media/walkthrough/store-key.md"
                        },
                        "completionEvents": [
                            "onCommand:tetrate-model-provider.setApiKey"
                        ]
                    },
                    {
                        "id": "enableModels",
                        "title": "Enable models in the picker",
                        "description": "Models contributed by an extension start out hidden. Run **Chat: Manage Language Models** from the Command Palette, select **Tetrate Agent Router**, and enable the models to offer.",
                        "media": {
                            "markdown": "media/walkthrough/enable-models.md"
                        }
                    }
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run clean && npm run bundle:prod",
        "clean": "rm -rf out",
        "esbuild": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node20",
        "bundle": "npm run esbuild -- --sourcemap",
        "bundle:prod": "npm run esbuild -- --minify",
        "compile": "npm run bundle",
        "watch": "npm run bundle -- --watch",
        "icon": "node scripts/build-icon.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vitest run",
        "package": "vsce package --no-dependencies",
        "publish": "vsce publish --no-dependencies"
    },
    "dependencies": {
        "openai": "^6.9.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "@resvg/resvg-js": "^2.6.2",
        "@types/node": "^22.20.0",
        "@types/vscode": "1.106.0",
        "@vscode/vsce": "^3.6.0",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.0",
        "vitest": "^5.0.1"
    }
}
